def adm_adj(req: AdminAdjustRequest, admin: dict = Depends(require_admin)):
    if req.amount > 0:
        add_credits(req.user_id, req.amount, req.reason, "admin_adj")
    else:
        deduct_credits_atomic(req.user_id, abs(req.amount), "admin_adj", req.reason)
    return {"status": "ok"}

