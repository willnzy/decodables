# ============================================================================
# Make Decodables Backend - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it's in .gitignore)
# ============================================================================

# ----------------------------------------------------------------------------
# Environment
# ----------------------------------------------------------------------------
ENV=development                # Options: development, staging, production
ENABLE_SCHEDULER=true          # Enable background task scheduler

# ----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
DATABASE_URL="postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres?pgbouncer=true"

# ----------------------------------------------------------------------------
# Authentication (Clerk)
# ----------------------------------------------------------------------------
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret_here
CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
YOUR_CLERK_PUBLIC_KEY_HERE
-----END PUBLIC KEY-----"

# ----------------------------------------------------------------------------
# Payment (Stripe)
# ----------------------------------------------------------------------------
# Secret Keys (Backend)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Publishable Key (Frontend - for reference, not used in backend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Price IDs (Created in Stripe Dashboard)
STRIPE_PRICE_CREDITS_100=price_your_credits_100_price_id
STRIPE_PRICE_SUB_STARTER=price_your_starter_subscription_price_id
STRIPE_PRICE_SUB_PRO=price_your_pro_subscription_price_id

# ----------------------------------------------------------------------------
# AI Services
# ----------------------------------------------------------------------------
# OpenAI (Text generation, AI reports, assistant)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_ASSISTANT_ID=asst_your_assistant_id_here

# FAL.ai (Image generation)
FAL_KEY=your_fal_api_key:your_fal_api_secret

# Qwen / DashScope (Alternative text generation, optional)
DASHSCOPE_API_KEY=sk-your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ----------------------------------------------------------------------------
# Cache (Redis) - Railway Optimized
# ----------------------------------------------------------------------------
# Redis connection URL (Railway auto-injects for Redis-Staging service)
REDIS_URL=redis://localhost:6379/0

# Connection pool settings (optimized for multi-instance deployment)
REDIS_MAX_CONNECTIONS=50         # Maximum connections in pool (default: 50, Railway production)
REDIS_SOCKET_TIMEOUT=5           # Socket timeout in seconds (default: 5)
REDIS_CONNECT_TIMEOUT=5          # Connection timeout in seconds (default: 5)
REDIS_HEALTH_CHECK_INTERVAL=30   # Health check interval in seconds (default: 30)

# ----------------------------------------------------------------------------
# Email (Resend)
# ----------------------------------------------------------------------------
# For customer support and notifications
RESEND_API_KEY=re_your_resend_api_key_here
SUPPORT_EMAIL=support@makedecodables.com
SUPPORT_EMAIL_FROM=noreply@makedecodables.com

# ----------------------------------------------------------------------------
# Frontend URL
# ----------------------------------------------------------------------------
# Used for Stripe checkout redirect and CORS
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Marketing Conversion API (Optional)
# ----------------------------------------------------------------------------
# Facebook Conversion API
FACEBOOK_PIXEL_ID=your_facebook_pixel_id
FACEBOOK_CAPI_TOKEN=your_facebook_capi_access_token

# TikTok Events API
TIKTOK_PIXEL_CODE=your_tiktok_pixel_code
TIKTOK_EVENTS_TOKEN=your_tiktok_events_access_token

# ----------------------------------------------------------------------------
# Worker Configuration (Railway worker-staging service)
# ----------------------------------------------------------------------------
# Comma-separated list of queues to process (priority order: high → default → low)
WORKER_QUEUES=high,default,low   # Default: high,default,low

# Custom worker name (optional, for monitoring)
WORKER_NAME=worker-1

# Memory optimization (Railway production settings)
WORKER_MAX_JOBS=100              # Restart worker after N jobs (default: 100, prevents memory leaks)
WORKER_JOB_TIMEOUT=600           # Job timeout in seconds (default: 600 = 10 minutes)

# ============================================================================
# Getting Your API Keys
# ============================================================================
#
# Supabase:
#   1. Visit https://supabase.com/dashboard
#   2. Select your project
#   3. Settings → API → Project URL & Service Role Key
#   4. Settings → Database → Connection String
#
# Clerk:
#   1. Visit https://dashboard.clerk.com
#   2. Select your application
#   3. Configure → Webhooks → Create endpoint
#   4. API Keys → Show JWT public key (PEM format)
#
# Stripe:
#   1. Visit https://dashboard.stripe.com
#   2. Developers → API Keys → Secret key
#   3. Developers → Webhooks → Add endpoint → Get signing secret
#   4. Products → Create products for:
#      - 100 Credits (one-time purchase)
#      - Starter Subscription ($14.9/month)
#      - Pro Subscription ($29.9/month)
#
# OpenAI:
#   1. Visit https://platform.openai.com/api-keys
#   2. Create new secret key
#   3. For Assistant: https://platform.openai.com/assistants
#
# FAL.ai:
#   1. Visit https://fal.ai/dashboard
#   2. API Keys → Create new key
#
# Resend:
#   1. Visit https://resend.com/api-keys
#   2. Create API Key
#   3. Verify domain in Settings → Domains
#
# Redis (Optional):
#   - Local: Run `docker run -d -p 6379:6379 redis`
#   - Cloud: Upstash (https://upstash.com) or Redis Cloud
#
# ============================================================================
# Environment-Specific Configuration
# ============================================================================
#
# Development (.env):
#   - Use test/sandbox keys (sk_test_, pk_test_, whsec_test_)
#   - FRONTEND_URL=http://localhost:3000
#   - ENV=development
#
# Staging:
#   - Use test keys
#   - FRONTEND_URL=https://staging.makedecodables.com
#   - ENV=staging
#   - Update webhook URLs in Clerk/Stripe to staging domain
#
# Production:
#   - Use live keys (sk_live_, pk_live_, whsec_live_)
#   - FRONTEND_URL=https://makedecodables.com
#   - ENV=production
#   - Update webhook URLs in Clerk/Stripe to production domain
#
# ============================================================================
# Security Notes
# ============================================================================
#
# 🔒 NEVER commit .env file to git
# 🔒 Use Railway/Vercel environment variables in production
# 🔒 Rotate keys regularly (every 90 days)
# 🔒 Use different keys for development/staging/production
# 🔒 Store backups of production keys in secure password manager
# 🔒 Verify SUPABASE_KEY is the SERVICE ROLE key (not anon key)
#
# ============================================================================
# Railway Deployment Guide
# ============================================================================
#
# Railway Architecture (3 Services):
#   - main-decodables (web): FastAPI web server
#   - worker-staging: Background task worker
#   - Redis-Staging: Shared Redis cache (Railway template)
#
# Required Variables by Service:
#
#   main-decodables (web service):
#     ✅ ENV, REDIS_URL, REDIS_MAX_CONNECTIONS, REDIS_SOCKET_TIMEOUT
#     ✅ REDIS_CONNECT_TIMEOUT, REDIS_HEALTH_CHECK_INTERVAL
#     ✅ SUPABASE_URL, SUPABASE_KEY
#     ✅ CLERK_PEM_PUBLIC_KEY, CLERK_WEBHOOK_SECRET
#     ✅ STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_*
#     ✅ OPENAI_API_KEY, FAL_KEY
#     ✅ FRONTEND_URL
#
#   worker-staging (worker service):
#     ✅ ENV, REDIS_URL
#     ✅ WORKER_QUEUES, WORKER_NAME, WORKER_MAX_JOBS, WORKER_JOB_TIMEOUT
#     ✅ SUPABASE_URL, SUPABASE_KEY (for task execution)
#     ✅ OPENAI_API_KEY, FAL_KEY (for AI task processing)
#
#   Redis-Staging:
#     ✅ No custom variables needed (Railway Redis template)
#
# Railway Environment Setup:
#   1. Set variables via Railway Dashboard (not in code)
#   2. REDIS_URL auto-injected by Railway when linking Redis-Staging
#   3. Use railway.toml for build/deploy configuration
#   4. Health check endpoint: /health (configured in railway.toml)
#
# Production Scaling Recommendations:
#   - main-decodables: 1GB RAM, 1 vCPU, 2+ instances for HA
#   - worker-staging: 512MB-1GB RAM, 1-3 workers based on load
#   - Redis-Staging: Railway Redis template (auto-managed)
#
# Monitoring:
#   - Basic health: GET /health (Railway auto-monitors)
#   - Detailed diagnostics: GET /health/detailed (queue stats, worker count)
#   - Check Railway Dashboard for service status and logs
#
# ============================================================================
